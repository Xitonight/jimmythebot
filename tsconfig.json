{
    "compilerOptions": {
        "incremental": true,
        "module": "NodeNext",
        "types": ["node"],
        "allowJs": true,
        "strict": true,
        "inlineSources": true,
        "outDir": "./dist",
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "./src"
    ],
    "exclude": [
        "**/node_modules"
    ]
}
